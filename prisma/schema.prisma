generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  firebaseUid            String                  @unique
  email                  String                  @unique
  name                   String?
  avatarUrl              String?
  role                   Role                    @default(STUDENT)
  branch                 Branch?
  year                   Int?
  goals                  ExamCategory[]
  onboardedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  userGoals              Goal[]
  internshipApplications InternshipApplication[]
  mockTests              MockTest[]
  notifications          Notification[]
  pinnedCountdowns       PinnedCountdown[]
  placementApplications  PlacementApplication[]
  placementProfile       PlacementProfile?
  resourceCompletions    ResourceCompletion[]
  savedItems             SavedItem[]
  studyLogs              StudyLog[]
  userAchievements       UserAchievement[]
  progress               UserProgress[]
  resumes                UserResume[]
  userXP                 UserXP?
  videoProgress          VideoProgress[]

  @@index([role])
}

model Exam {
  id                  String         @id @default(cuid())
  slug                String         @unique
  title               String
  shortTitle          String
  category            ExamCategory
  branch              Branch?
  isActive            Boolean        @default(true)
  overview            String
  eligibility         String
  examPattern         String
  syllabus            String
  metadata            Json           @default("{}")
  examDate            DateTime?
  applicationDeadline DateTime?
  coverImageUrl       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  cutoffs             Cutoff[]
  companies           ExamCompany[]
  faqs                FAQ[]
  pyqs                PYQ[]
  resources           Resource[]
  roadmaps            Roadmap[]
  savedItems          SavedItem[]
  progress            UserProgress[]
  videos              Video[]

  @@index([category])
  @@index([branch])
  @@index([isActive])
}

model Cutoff {
  id       String @id @default(cuid())
  examId   String
  year     Int
  category String
  value    Float
  unit     String
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, year])
}

model FAQ {
  id       String @id @default(cuid())
  examId   String
  question String
  answer   String
  order    Int    @default(0)
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model Resource {
  id                  String               @id @default(cuid())
  title               String
  description         String?
  type                ResourceType
  fileUrl             String
  fileType            String?
  sizeBytes           Int?
  examId              String
  branch              Branch?
  subject             String
  uploadedById        String?
  saveCount           Int                  @default(0)
  viewCount           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  exam                Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  resourceCompletions ResourceCompletion[]
  savedItems          SavedItem[]
  progress            UserProgress[]

  @@index([examId, branch, subject, type])
}

model PYQ {
  id          String         @id @default(cuid())
  examId      String
  year        Int
  session     String?
  subject     String?
  questionUrl String
  solutionUrl String?
  hasSolution Boolean        @default(false)
  createdAt   DateTime       @default(now())
  exam        Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  savedItems  SavedItem[]
  progress    UserProgress[]

  @@index([examId, year])
}

enum VideoType {
  VIDEO
  PLAYLIST
}

model Video {
  id              String          @id @default(cuid())
  examId          String

  title           String

  videoType       VideoType       @default(VIDEO)

  youtubeId       String

  channel         String

  subject         String?

  durationSeconds Int?

  thumbnailUrl    String?

  playlistId      String?

  createdAt       DateTime        @default(now())

  progress        UserProgress[]

  exam            Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)

  videoProgress   VideoProgress[]

  @@index([examId, subject])

  @@index([videoType])
}

model Company {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  logoUrl         String?
  companyType     CompanyType
  description     String?
  website         String?
  avgPackageLpa   Float?
  rolesHiredFor   String[]
  recruitsViaGate Boolean?      @default(false)
  createdAt       DateTime      @default(now())
  exams           ExamCompany[]

  @@index([companyType])
}

model ExamCompany {
  examId    String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([examId, companyId])
}

model Roadmap {
  id          String        @id @default(cuid())
  examId      String
  title       String
  description String?
  createdAt   DateTime      @default(now())
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  steps       RoadmapStep[]

  @@index([examId])
}

model RoadmapStep {
  id          String         @id @default(cuid())
  roadmapId   String
  order       Int
  title       String
  description String?
  resourceUrl String?
  roadmap     Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  progress    UserProgress[]

  @@index([roadmapId, order])
}

model UserProgress {
  id            String              @id @default(cuid())
  userId        String
  contentType   ProgressContentType
  status        ProgressStatus      @default(VIEWED)
  examId        String?
  resourceId    String?
  pyqId         String?
  videoId       String?
  roadmapStepId String?
  lastViewedAt  DateTime            @default(now())
  createdAt     DateTime            @default(now())
  watchSeconds  Int                 @default(0)
  exam          Exam?               @relation(fields: [examId], references: [id])
  pyq           PYQ?                @relation(fields: [pyqId], references: [id])
  resource      Resource?           @relation(fields: [resourceId], references: [id])
  roadmapStep   RoadmapStep?        @relation(fields: [roadmapStepId], references: [id])
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  video         Video?              @relation(fields: [videoId], references: [id])

  @@index([userId, lastViewedAt])
  @@index([userId, contentType])
}

model SavedItem {
  id         String    @id @default(cuid())
  userId     String
  examId     String?
  resourceId String?
  pyqId      String?
  createdAt  DateTime  @default(now())
  exam       Exam?     @relation(fields: [examId], references: [id], onDelete: Cascade)
  pyq        PYQ?      @relation(fields: [pyqId], references: [id], onDelete: Cascade)
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudyLog {
  id           String        @id @default(cuid())
  userId       String
  date         DateTime      @db.Date
  topic        String
  subject      String
  minutes      Int
  notes        String?
  examCategory ExamCategory?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, examCategory])
}

model ExamCountdown {
  id          String            @id @default(cuid())
  title       String
  examDate    DateTime
  category    ExamCategory?
  description String?
  isActive    Boolean           @default(true)
  isPinnable  Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  pinnedBy    PinnedCountdown[]

  @@index([examDate])
}

model PinnedCountdown {
  userId      String
  countdownId String
  countdown   ExamCountdown @relation(fields: [countdownId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, countdownId])
}

model Goal {
  id           String        @id @default(cuid())
  userId       String
  title        String
  description  String?
  targetValue  Int           @default(100)
  currentValue Int           @default(0)
  unit         String        @default("percent")
  deadline     DateTime?
  isCompleted  Boolean       @default(false)
  completedAt  DateTime?
  examCategory ExamCategory?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCompleted])
}

model MockTest {
  id           String       @id @default(cuid())
  userId       String
  examCategory ExamCategory
  testName     String?
  score        Float
  totalMarks   Float
  takenAt      DateTime     @default(now())
  durationMin  Int?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, examCategory])
  @@index([userId, takenAt])
}

model VideoProgress {
  id          String    @id @default(cuid())
  userId      String
  videoId     String
  watchedSecs Int       @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
}

model ResourceCompletion {
  id          String   @id @default(cuid())
  userId      String
  resourceId  String
  completedAt DateTime @default(now())
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
}

model AIRoadmap {
  id          String       @id @default(cuid())
  userId      String
  branch      Branch
  targetExam  ExamCategory
  currentYear Int
  content     Json
  createdAt   DateTime     @default(now())

  @@unique([userId, branch, targetExam])
  @@index([userId])
}

model PlacementApplication {
  id          String          @id @default(cuid())
  userId      String
  companyName String
  companySlug String?
  role        String
  status      PlacementStatus @default(APPLIED)
  appliedAt   DateTime        @default(now())
  oaClearedAt DateTime?
  interviewAt DateTime?
  resultAt    DateTime?
  notes       String?
  ctcOffered  Float?
  jobLink     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, appliedAt])
}

model PlacementProfile {
  id     String @id @default(cuid())
  userId String @unique

  resumeUrl String?
  skills    String?
  cgpa      Float?
  branch    Branch?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Internship {
  id           String                  @id @default(cuid())
  title        String
  company      String
  location     String?
  workMode     WorkMode                @default(ONSITE)
  stipendMin   Float?
  stipendMax   Float?
  duration     String?
  applyLink    String
  source       String
  deadline     DateTime?
  isActive     Boolean                 @default(true)
  branches     Branch[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  applications InternshipApplication[]

  @@index([workMode, isActive])
  @@index([deadline])
}

model InternshipApplication {
  id           String           @id @default(cuid())
  userId       String
  internshipId String
  status       InternshipStatus @default(APPLIED)
  appliedAt    DateTime         @default(now())
  notes        String?
  internship   Internship       @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, internshipId])
  @@index([userId, status])
}

model PSUCompany {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  logoUrl          String?
  sector           String
  branches         Branch[]
  minGateScore     Float?
  avgSalaryLpa     Float?
  maxSalaryLpa     Float?
  selectionProcess String?
  description      String?
  officialUrl      String?
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  cutoffs          PSUCutoff[]

  @@index([isActive])
}

model PSUCutoff {
  id        String     @id @default(cuid())
  psuId     String
  year      Int
  branch    Branch
  category  String
  gateScore Float
  rank      Int?
  psu       PSUCompany @relation(fields: [psuId], references: [id], onDelete: Cascade)

  @@index([psuId, year])
}

model Scholarship {
  id          String          @id @default(cuid())
  title       String
  provider    String
  type        ScholarshipType
  amount      String
  deadline    DateTime?
  eligibility String
  applyLink   String
  isActive    Boolean         @default(true)
  branches    Branch[]
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, isActive])
  @@index([deadline])
}

model UserResume {
  id        String             @id @default(cuid())
  userId    String
  title     String             @default("My Resume")
  template  ResumeTemplateType @default(FRESHER)
  data      Json
  atsScore  Int?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Achievement {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  description      String
  icon             String
  xpReward         Int                 @default(100)
  category         AchievementCategory
  condition        Json
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model UserXP {
  userId    String   @id
  totalXP   Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Branch {
  CSE
  ECE
  ME
  CE
  EE
  IT
  CHEMICAL
  OTHER
}

enum Role {
  STUDENT
  ADMIN
}

enum ExamCategory {
  GATE
  PSU
  CAT
  PLACEMENT
  CUET_PG
  ESE
  GRE
  TOEFL
  IELTS
  ISRO
  DRDO
  BARC
}

enum ResourceType {
  NOTES
  FORMULA_SHEET
  BOOK
  PDF
  LINK
}

enum CompanyType {
  PSU
  PLACEMENT
}

enum ProgressStatus {
  VIEWED
  IN_PROGRESS
  COMPLETED
}

enum ProgressContentType {
  RESOURCE
  PYQ
  VIDEO
  ROADMAP_STEP
  EXAM
}

enum PlacementStatus {
  APPLIED
  OA_CLEARED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum InternshipStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

enum ScholarshipType {
  GOVERNMENT
  PRIVATE
  INTERNATIONAL
}

enum NotificationType {
  EXAM_UPDATE
  DEADLINE_ALERT
  NEW_RESOURCE
  MOCK_REMINDER
  STREAK_ALERT
  ACHIEVEMENT
  SYSTEM
}

enum AchievementCategory {
  STREAK
  STUDY
  MOCK_TEST
  GOAL
  RESOURCE
  PLACEMENT
}

enum ResumeTemplateType {
  FRESHER
  INTERNSHIP
  RESEARCH
}
